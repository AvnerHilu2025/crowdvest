generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Reference data (Stage 1 – extensible for Stage 2)
// ---------------------------------------------------------------------------

model Archetype {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  traitProfiles ArchetypeTraitProfile[]
  agents        Agent[]
}

model TraitDefinition {
  id             String   @id @default(uuid()) @db.Uuid
  key            String   @unique
  displayName    String
  description    String?
  valueRangeText String?
  minValue       Float?
  maxValue       Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  archetypeProfiles ArchetypeTraitProfile[]
}

model ArchetypeTraitProfile {
  archetypeId       String @db.Uuid
  traitDefinitionId String @db.Uuid
  baselineValue     Float

  archetype       Archetype       @relation(fields: [archetypeId], references: [id], onDelete: Cascade)
  traitDefinition TraitDefinition @relation(fields: [traitDefinitionId], references: [id], onDelete: Cascade)

  @@unique([archetypeId, traitDefinitionId])
}

// ---------------------------------------------------------------------------
// Runtime / simulation (Stage 1 – extensible for Stage 2)
// ---------------------------------------------------------------------------

model Agent {
  id          String   @id @default(uuid()) @db.Uuid
  displayName String
  archetypeId String   @db.Uuid
  stateJson   Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  archetype Archetype    @relation(fields: [archetypeId], references: [id], onDelete: Restrict)
  wallet    AgentWallet?
  bets      Bet[]
}

model AgentWallet {
  agentId   String   @id @db.Uuid
  balance   Float    @default(0)
  updatedAt DateTime @updatedAt

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

enum SimulationRunStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model SimulationRun {
  id             String              @id @default(uuid()) @db.Uuid
  name           String
  status         SimulationRunStatus @default(PENDING)
  seed           Int
  modelVersion   String
  datasetVersion String
  codeGitSha     String?
  schemaVersion  String
  startedAt      DateTime?
  finishedAt     DateTime?
  completedAt    DateTime?
  failedAt       DateTime?
  lastError      String?             @db.VarChar(1000)
  runDurationMs  Int?
  configJson     Json?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  agentExperiences AgentExperience[]
  crowdSnapshots   CrowdSnapshot[]
  runDebug         RunDebug?
  bets             Bet[]
  runTimeSeries    RunTimeSeries[]
  runAgents        RunAgent[]
  agentDecisions   AgentDecision[]
  crowdMetrics     CrowdMetrics[]
  infoEvents       InfoEvent[]
  agentInfoStates  AgentInfoState[]
  agentStates      AgentState[]
  assetStepReturns AssetStepReturn[]
  agentRewards     AgentReward[]
  runVariants      RunVariant[]

  @@unique([name, datasetVersion])
}

// ---------------------------------------------------------------------------
// Run variant – per-seed (or label) scope for backtest; decisions/metrics keyed by runVariantId
// ---------------------------------------------------------------------------

model RunVariant {
  id          String    @id @default(uuid()) @db.Uuid
  runId       String    @db.Uuid
  assetSymbol String
  seed        Int
  agents      Int
  steps       Int
  label       String? // optional batch tag (e.g. "smoke-variants")
  createdAt   DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  durationMs  Int?

  run              SimulationRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  agentDecisions   AgentDecision[]
  agentInfoStates  AgentInfoState[]
  agentStates      AgentState[]
  agentExperiences AgentExperience[]
  crowdMetrics     CrowdMetrics[]
  agentRewards     AgentReward[]
  backtestResults  BacktestResult[]
  summary          RunVariantSummary?

  @@unique([runId, assetSymbol, seed, label])
  @@index([runId, assetSymbol])
  @@index([runId, assetSymbol, createdAt])
}

model RunVariantSummary {
  id                  String   @id @default(uuid()) @db.Uuid
  runVariantId        String   @unique @db.Uuid
  corr                Float
  directionalAccuracy Float
  pairsCount          Int
  computedAt          DateTime @default(now())
  // Debug / validation: deterministic fingerprints for seed isolation (decisionsHash differs per seed; returnsHash identical)
  debugDecisionCounts Json? // { BUY: n, SELL: n, HOLD: n } — exposed as summary.decisionCounts
  debugPairsSample    Json? // first N pairs: [{ step, r, predictedSign, actualSign }]
  debugDecisionsHash  String? // sha256(decisions ordered by step,agentId) — exposed as summary.decisionsHash
  debugReturnsHash    String? // sha256(step returns) — exposed as summary.returnsHash

  runVariant RunVariant @relation(fields: [runVariantId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Agents v1 – diverse virtual investors (per-run, with traits)
// ---------------------------------------------------------------------------

model RunAgent {
  id         String   @id @default(uuid()) @db.Uuid
  runId      String   @db.Uuid
  name       String
  archetype  String?
  biases     Json?
  humanState Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  run          SimulationRun     @relation(fields: [runId], references: [id], onDelete: Cascade)
  traits       RunAgentTrait[]
  decisions    AgentDecision[]
  infoStates   AgentInfoState[]
  agentStates  AgentState[]
  experiences  AgentExperience[]
  agentRewards AgentReward[]

  @@index([runId])
}

model RunAgentTrait {
  id        String   @id @default(uuid()) @db.Uuid
  agentId   String   @db.Uuid
  key       String
  valueNum  Float?
  valueStr  String?
  createdAt DateTime @default(now())

  agent RunAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([key])
}

// ---------------------------------------------------------------------------
// Decision Engine v1 – per-agent BUY/SELL/HOLD with confidence
// ---------------------------------------------------------------------------

enum AgentDecisionAction {
  BUY
  SELL
  HOLD
}

model AgentDecision {
  id           String              @id @default(uuid()) @db.Uuid
  runId        String              @db.Uuid
  runVariantId String?             @db.Uuid
  step         Int
  agentId      String              @db.Uuid
  assetSymbol  String              @default("RUN")
  action       AgentDecisionAction
  confidence   Float
  rationale    String?
  createdAt    DateTime            @default(now())

  run        SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runVariant RunVariant?   @relation(fields: [runVariantId], references: [id], onDelete: Cascade)
  agent      RunAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([runId, step, agentId, assetSymbol, runVariantId])
  @@index([runId])
  @@index([runVariantId])
  @@index([step])
  @@index([agentId])
}

// ---------------------------------------------------------------------------
// Crowd Intelligence – aggregated metrics per (runId, assetSymbol, step)
// ---------------------------------------------------------------------------

model CrowdMetrics {
  id                String   @id @default(uuid()) @db.Uuid
  runId             String   @db.Uuid
  runVariantId      String?  @db.Uuid
  assetSymbol       String
  step              Int
  signal            Float
  weightedSignal    Float
  consensus         Float
  polarization      Float
  uncertainty       Float
  minorityStrength  Float
  beliefMomentum    Float?
  diversityIndex    Float?
  independenceIndex Float?
  herdingIndex      Float?
  wisdomScore       Float?
  noiseSensitivity  Float?
  createdAt         DateTime @default(now())

  run        SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runVariant RunVariant?   @relation(fields: [runVariantId], references: [id], onDelete: Cascade)

  @@unique([runId, assetSymbol, step, runVariantId])
  @@index([runId])
  @@index([runVariantId])
  @@index([runId, assetSymbol])
}

// ---------------------------------------------------------------------------
// Reward Loop v1 – per-step returns and per-agent rewards (PnL, regret, drawdown)
// ---------------------------------------------------------------------------

model AssetStepReturn {
  id          String   @id @default(uuid()) @db.Uuid
  runId       String   @db.Uuid
  assetSymbol String
  step        Int
  stepReturn  Float
  createdAt   DateTime @default(now())

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, assetSymbol, step])
  @@index([runId, assetSymbol])
}

model AgentReward {
  id           String              @id @default(uuid()) @db.Uuid
  runId        String              @db.Uuid
  runVariantId String?             @db.Uuid
  agentId      String              @db.Uuid
  assetSymbol  String
  step         Int
  action       AgentDecisionAction
  stepReturn   Float
  pnl          Float
  regret       Float
  drawdown     Float
  rewardScore  Float
  createdAt    DateTime            @default(now())

  run        SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runVariant RunVariant?   @relation(fields: [runVariantId], references: [id], onDelete: Cascade)
  agent      RunAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([runId, agentId, assetSymbol, step, runVariantId])
  @@index([runId, assetSymbol, step])
  @@index([runVariantId])
}

// ---------------------------------------------------------------------------
// InfoFeed – news/rumors per run+asset+step, exposure per agent
// ---------------------------------------------------------------------------

model InfoEvent {
  id               String   @id @default(uuid()) @db.Uuid
  runId            String   @db.Uuid
  assetSymbol      String
  step             Int
  topic            String
  sentiment        Float
  credibility      Float
  reach            Float
  volatilityImpact Float?
  source           String?
  createdAt        DateTime @default(now())

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, assetSymbol, step])
  @@index([runId, assetSymbol])
}

model AgentInfoState {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @db.Uuid
  runVariantId  String?  @db.Uuid
  assetSymbol   String
  agentId       String   @db.Uuid
  step          Int
  exposedCount  Int
  infoSignal    Float
  confidence    Float? // 0..1, learning state (when learning enabled)
  riskTolerance Float? // 0..1
  herding       Float? // 0..1
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  run        SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runVariant RunVariant?   @relation(fields: [runVariantId], references: [id], onDelete: Cascade)
  agent      RunAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([runId, assetSymbol, agentId, step, runVariantId])
  @@index([runId])
  @@index([runVariantId])
  @@index([runId, assetSymbol])
}

// ---------------------------------------------------------------------------
// AgentState – single source of truth for learning state (confidence/riskTolerance/herding) per step
// ---------------------------------------------------------------------------

model AgentState {
  id            String   @id @default(uuid()) @db.Uuid
  runId         String   @db.Uuid
  runVariantId  String?  @db.Uuid
  assetSymbol   String
  agentId       String   @db.Uuid
  step          Int
  confidence    Float // 0..1
  riskTolerance Float // 0..1
  herding       Float // 0..1
  infoSignal    Float
  exposedCount  Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt

  run        SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runVariant RunVariant?   @relation(fields: [runVariantId], references: [id], onDelete: Cascade)
  agent      RunAgent      @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([runId, assetSymbol, agentId, step, runVariantId])
  @@index([runId, assetSymbol, step])
  @@index([runVariantId])
  @@index([runId, assetSymbol, agentId])
}

// ---------------------------------------------------------------------------
// Run Timeline (4B-v2: linear curve for settlement)
// ---------------------------------------------------------------------------

model RunTimeSeries {
  id        String   @id @default(uuid()) @db.Uuid
  runId     String   @db.Uuid
  step      Int
  value     Float
  createdAt DateTime @default(now())

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, step])
  @@index([runId, step])
}

model RunDebug {
  runId                   String   @id @db.Uuid
  prePersistHistogram     Json?
  samplePrePersistActions Json?
  createdAt               DateTime @default(now())

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
}

model AgentExperience {
  id               String   @id @default(uuid()) @db.Uuid
  runId            String   @db.Uuid
  runVariantId     String?  @db.Uuid
  runAgentId       String   @db.Uuid
  step             Int
  ts               DateTime
  actionJson       Json?
  signalsJson      Json?
  pnl              Float?
  drawdown         Float?
  reward           Float?
  learningMetaJson Json?
  stateBeforeJson  Json?
  stateAfterJson   Json?

  run        SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  runVariant RunVariant?   @relation(fields: [runVariantId], references: [id], onDelete: Cascade)
  runAgent   RunAgent      @relation(fields: [runAgentId], references: [id], onDelete: Cascade)

  @@unique([runId, runAgentId, step, runVariantId])
  @@index([runAgentId, ts])
  @@index([runId, step])
  @@index([runVariantId])
  @@index([runId, runAgentId, step])
}

model CrowdSnapshot {
  id              String   @id @default(uuid()) @db.Uuid
  runId           String   @db.Uuid
  step            Int
  ts              DateTime
  aggregationJson Json?
  confidence      Float?

  run SimulationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, step])
}

// ---------------------------------------------------------------------------
// Import tracking (Package A+)
// ---------------------------------------------------------------------------

// ---------------------------------------------------------------------------
// Identity (Identity-Lite – multi-user without auth)
// ---------------------------------------------------------------------------

model UserProfile {
  userId      String   @id
  displayName String
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Wallet (Retention Core)
// ---------------------------------------------------------------------------

model UserWallet {
  userId    String   @id
  balance   Float    @default(100)
  updatedAt DateTime @updatedAt
}

enum WalletTransactionType {
  SEED
  BET_DEBIT
  BET_CREDIT
  ADJUSTMENT
}

model UserWalletTransaction {
  id        String                @id @default(uuid()) @db.Uuid
  userId    String
  type      WalletTransactionType
  amount    Float
  betId     String?               @db.Uuid
  runId     String?               @db.Uuid
  note      String?
  createdAt DateTime              @default(now())

  bet Bet? @relation(fields: [betId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([betId])
  @@index([runId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Bets (v1 product)
// ---------------------------------------------------------------------------

enum BetDirection {
  BUY
  SELL
}

enum BetStatus {
  OPEN
  SETTLED
  CANCELLED
}

model Bet {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String
  runId        String       @db.Uuid
  agentId      String?      @db.Uuid
  decisionStep Int?
  assetSymbol  String
  direction    BetDirection
  amount       Float
  status       BetStatus    @default(OPEN)
  openPrice    Float
  openStep     Int
  closePrice   Float?
  closeStep    Int?
  pnl          Float        @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  run                    SimulationRun           @relation(fields: [runId], references: [id], onDelete: Cascade)
  agent                  Agent?                  @relation(fields: [agentId], references: [id], onDelete: SetNull)
  userWalletTransactions UserWalletTransaction[]

  @@index([userId])
  @@index([runId])
  @@index([assetSymbol])
  @@index([userId, createdAt])
  @@index([runId, createdAt])
  @@index([userId, status, createdAt])
  @@index([runId, status, createdAt])
}

// ---------------------------------------------------------------------------
// Import tracking (Package A+)
// ---------------------------------------------------------------------------

model ImportRun {
  id             String    @id @default(uuid()) @db.Uuid
  type           String
  sourceFilename String
  sourceHash     String
  status         String
  summaryJson    Json?
  errorJson      Json?
  startedAt      DateTime
  finishedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

// ---------------------------------------------------------------------------
// Backtesting v0 – price series ingestion and window results
// ---------------------------------------------------------------------------

model PriceSeriesPoint {
  id        String   @id @default(uuid()) @db.Uuid
  symbol    String
  date      String // YYYY-MM-DD
  close     Float
  createdAt DateTime @default(now())

  @@unique([symbol, date])
  @@index([symbol])
  @@index([symbol, date])
}

model BacktestWindowResult {
  id        String   @id @default(uuid()) @db.Uuid
  symbol    String
  runId     String   @db.Uuid
  fromDate  String // YYYY-MM-DD
  toDate    String // YYYY-MM-DD
  window    Int
  stride    Int
  agents    Int
  seed      Int
  corr      Float
  hitRate   Float
  createdAt DateTime @default(now())

  @@index([symbol])
  @@index([symbol, createdAt])
}

model BacktestResult {
  id                  String   @id @default(uuid()) @db.Uuid
  runId               String   @db.Uuid
  runVariantId        String?  @db.Uuid
  assetSymbol         String
  seed                Int
  steps               Int
  agents              Int
  pairsCount          Int? // steps-1 when present (pred/ret pairs for corr)
  corr                Float?
  directionalAccuracy Float?
  createdAt           DateTime @default(now())

  runVariant RunVariant? @relation(fields: [runVariantId], references: [id], onDelete: Cascade)

  @@index([assetSymbol])
  @@index([assetSymbol, createdAt])
  @@index([runId, assetSymbol])
  @@index([runVariantId])
}

// ---------------------------------------------------------------------------
// Forecast Accuracy Engine (Phase 2)
// ---------------------------------------------------------------------------

model ForecastResult {
  id                   String              @id @default(uuid()) @db.Uuid
  runId                String              @db.Uuid
  assetSymbol          String
  step                 Int
  forecastDirection    AgentDecisionAction
  totalVotes           Int
  buyVotes             Int
  sellVotes            Int
  holdVotes            Int
  groundTruthDirection AgentDecisionAction
  isCorrect            Boolean
  createdAt            DateTime            @default(now())

  @@unique([runId, assetSymbol, step])
  @@index([runId])
}

model RunAccuracy {
  id               String   @id @default(uuid()) @db.Uuid
  runId            String   @db.Uuid
  assetSymbol      String
  totalEvaluations Int
  correctCount     Int
  accuracyRate     Float
  buyAccuracy      Float
  sellAccuracy     Float
  holdAccuracy     Float
  computedAt       DateTime @default(now())

  @@unique([runId, assetSymbol])
  @@index([runId])
}

model RunSignalDiagnostics {
  id          String @id @default(uuid()) @db.Uuid
  runId       String @db.Uuid
  assetSymbol String

  totalSteps Int

  pctCrowdBuy  Float
  pctCrowdSell Float
  pctCrowdHold Float

  pctMarketUp   Float
  pctMarketDown Float
  pctMarketFlat Float

  buyCorrect  Int
  buyWrong    Int
  sellCorrect Int
  sellWrong   Int
  holdCorrect Int
  holdWrong   Int

  computedAt DateTime @default(now())

  @@unique([runId, assetSymbol])
  @@index([runId])
}
