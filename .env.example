# Database (required for API and worker)
DATABASE_URL=postgresql://user:password@localhost:5432/crowdvest?schema=public

# Optional: Redis (if used)
# REDIS_URL=redis://localhost:6379

# Ports for dev are fixed in package.json (Web 4000, API 4001).
# Override only if needed: PORT=4001 for API when running from apps/api.

# Optional: sim-core sell rules (defaults: TAKE_PROFIT=0.001, STOP_LOSS=0.001, MAX_HOLD_STEPS=2)
# TAKE_PROFIT=0.001
# STOP_LOSS=0.001
# MAX_HOLD_STEPS=2
