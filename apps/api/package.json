{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "import:full-history": "tsx scripts/importFullHistory.ts",
    "bench:gate": "node scripts/bench-gate-check.mjs",
    "build": "nest build && node -e \"const fs=require('fs');const p='dist/app.module.js';if(!fs.existsSync(p)){console.error('Build failed: dist/app.module.js not emitted');process.exit(1)}\"",
    "db:status": "pnpm -C ../../packages/db run db:status",
    "db:deploy": "pnpm -C ../../packages/db run db:deploy",
    "db:dev": "pnpm -C ../../packages/db run db:dev",
    "db:resolve-applied": "pnpm -C ../../packages/db run db:resolve-applied",
    "db:resolve-rolled-back": "pnpm -C ../../packages/db run db:resolve-rolled-back",
    "dev": "node ../../scripts/check-port.js 4001 && PORT=4001 nest start --watch",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
    "start": "nest start",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node -e \"const fs=require('fs');if(!fs.existsSync('dist/app.module.js')){console.error('Run pnpm build first. dist/app.module.js missing.');process.exit(1)}\" && node ./dist/main.js",
    "test": "jest --config ./test/jest-e2e.json",
    "test:e2e": "jest --config ./test/jest-e2e.json"
  },
  "dependencies": {
    "@crowdvest/db": "workspace:*",
    "@crowdvest/sim-core": "workspace:*",
    "@prisma/client": "^5.22.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "@crowdvest/shared": "workspace:*",
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "express": "^4.21.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.2.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.0.0",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.0",
    "typescript": "^5.6.0"
  }
}
